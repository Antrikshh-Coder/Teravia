# ==============================================================================
# TERAVIA — Environmental Intelligence Platform
# Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / React)
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend. In local development with Vite proxy, '/api' is used.
VITE_API_URL="/api"

# Supabase Project URL and Public Anon Key for Supabase Auth & RLS.
# Retrieve these from your Supabase Dashboard -> Project Settings -> API.
# Note: In development without credentials, TERAVIA seamlessly uses a built-in guest session.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Map Provider Configuration ('carto' | 'osm')
VITE_MAP_PROVIDER="osm"

# Application Public Origin
VITE_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Python / FastAPI)
# ------------------------------------------------------------------------------
# Application Environment ('development' | 'production')
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Allowed CORS Origins (comma-separated string or JSON array)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# PostgreSQL / Supabase Database Connection URI:
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# In local development when DATABASE_URL is left empty, the backend automatically uses
# a local persistent SQLite database ('teravia_local.db') with automated schema migrations.
DATABASE_URL=""

# Supabase Auth Server-side Verification:
# Your Supabase Project URL (same as frontend VITE_SUPABASE_URL)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (Keep confidential, NEVER expose to frontend or git)
# Used for backend administrative operations and user validation.
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase JWT Secret (found under Project Settings -> API -> JWT Settings)
# Used to verify user access tokens on protected endpoints.
SUPABASE_JWT_SECRET=""

# Native JWT Signing Secret (used for local persistent database auth)
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"

# Singapore Data.gov.sg API:
# Free public APIs do not strictly require an API key, but you can configure one
# for higher rate limits from https://developer.data.gov.sg/
DATA_GOV_SG_API_KEY=""
DATA_GOV_SG_BASE_URL="https://api.data.gov.sg/v1/environment"

# Open-Meteo Weather API:
# Free and does not require an API key for non-commercial open data usage.
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# In-Memory Cache TTL Settings (in seconds):
CACHE_TTL_ENVIRONMENTAL=300
CACHE_TTL_WEATHER=600
CACHE_TTL_LOCATIONS=3600
