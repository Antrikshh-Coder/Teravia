# ==============================================================================
# TERAVIA FastAPI Backend — Environment Configuration Template
# Copy to backend/.env to customize backend runtime parameters.
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Allowed CORS Origins (comma-separated string)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Database Connection (PostgreSQL / Supabase):
# e.g.: postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Leave empty to use local persistent SQLite database ('teravia_local.db')
DATABASE_URL=""

# Supabase Auth Verification:
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Singapore Data.gov.sg API:
DATA_GOV_SG_API_KEY=""
DATA_GOV_SG_BASE_URL="https://api.data.gov.sg/v1/environment"

# Open-Meteo Weather API:
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# In-Memory Cache TTL (seconds):
CACHE_TTL_ENVIRONMENTAL=300
CACHE_TTL_WEATHER=600
CACHE_TTL_LOCATIONS=3600
